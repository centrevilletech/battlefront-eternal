// The three page looks from electron/ui/looks.css, imported by
// menus/themes/page/style.js. Complex CSS tokens have typed native values:
// border width/color, shadow layers, chamfer size, grid and movie grading.
import "../../bfe-client/assets/fonts/saira-400.ttf";
import "../../bfe-client/assets/fonts/saira-600.ttf";
import "../../bfe-client/assets/fonts/saira-700.ttf";
import "../../bfe-client/assets/fonts/saira-800-normal.ttf";
import "../../bfe-client/assets/fonts/saira-800.ttf";
import "../../bfe-client/assets/fonts/saira-900.ttf";

export struct SurfaceBorder { width: length, color: color }
export struct SurfaceShadow { x: length, y: length, blur: length, color: color, inset: bool }
export struct MovieFilter { saturation: float, contrast: float, brightness: float }
export struct Pattern { major: length, minor: length, major-color: color, minor-color: color, scanlines: bool }
export enum MenuSound { select, accept, back, error }
export enum ControlState { idle, hover, pressed, focused, disabled }

export global Theme {
    in-out property <string> menu-theme: "eternal";
    in-out property <length> viewport-width: 1280px;
    in-out property <length> viewport-height: 720px;
    out property <bool> bf1: self.menu-theme == "bf1";
    out property <bool> bf2: self.menu-theme == "bf2";
    out property <bool> eternal: !self.bf1 && !self.bf2;
    out property <length> vw: self.viewport-width / 100;
    out property <length> vh: self.viewport-height / 100;
    // The host binds existing menu audio and Unicode label casing once.
    callback sound-requested(MenuSound);
    pure callback format-label(string, bool) -> string;

    out property <brush> bfe-backdrop: self.bf1 ? @radial-gradient(circle, #0c2858 0%, #061531 48%, #01040c 100%) : self.bf2 ? @radial-gradient(circle, #1d3f73 0%, #10284f 50%, #050c1a 100%) : #030406;
    out property <MovieFilter> bfe-movie-filter: self.bf1 ? { saturation: 0.9, contrast: 1.05, brightness: 0.95 } : self.bf2 ? { saturation: 0.85, contrast: 1.08, brightness: 0.9 } : { saturation: 1.05, contrast: 1.06, brightness: 0.92 };
    out property <brush> bfe-side-wash: self.bf1 ? @linear-gradient(180deg, rgba(40, 110, 230, 0.35), rgba(20, 60, 150, 0.3)) : self.bf2 ? @linear-gradient(180deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.05) 40%, rgba(0, 0, 0, 0.45)) : @linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.05) 35%, rgba(0, 0, 0, 0.1) 65%, rgba(0, 0, 0, 0.55) 100%);
    out property <bool> bfe-side-blend: self.bf1 ? true : self.bf2 ? false : false;
    out property <brush> bfe-scrim: self.bf1 ? @radial-gradient(circle, rgba(6, 26, 70, 0.9) 0%, rgba(4, 18, 52, 0.74) 50%, rgba(4, 18, 52, 0) 100%) : self.bf2 ? @radial-gradient(circle, rgba(16, 38, 74, 0.92) 0%, rgba(12, 30, 60, 0.76) 50%, rgba(12, 30, 60, 0) 100%) : @radial-gradient(circle, rgba(3, 4, 7, 0.93) 0%, rgba(3, 4, 7, 0.78) 50%, rgba(3, 4, 7, 0) 100%);
    out property <color> bfe-dim: self.bf1 ? rgba(2, 10, 30, 0.5) : self.bf2 ? rgba(6, 14, 30, 0.5) : rgba(2, 3, 6, 0.5);
    out property <Pattern> bfe-pattern: self.bf1 ? { major: 46px, minor: 0px, major-color: rgba(150,205,255,0.16), minor-color: transparent, scanlines: false } : self.bf2 ? { major: 160px, minor: 32px, major-color: rgba(190,215,255,0.2), minor-color: rgba(190,215,255,0.09), scanlines: false } : { major: 0px, minor: 4px, major-color: rgba(255,255,255,0.035), minor-color: transparent, scanlines: true };
    out property <float> bfe-pattern-opacity: self.bf1 ? 0.55 : self.bf2 ? 0.8 : 1;
    out property <color> bfe-logo-face: self.bf1 ? #cfe4ff : self.bf2 ? #e9edf2 : #d7dde6;
    out property <[SurfaceShadow]> bfe-logo-depth: self.bf1 ? [{ x: 0px, y: 1px, blur: 0px, color: #6f97d8, inset: false }, { x: 0px, y: 2px, blur: 0px, color: #5d86cc, inset: false }, { x: 0px, y: 3px, blur: 0px, color: #4c75bf, inset: false }, { x: 0px, y: 4px, blur: 0px, color: #3c64b0, inset: false }, { x: 0px, y: 5px, blur: 0px, color: #2f55a0, inset: false }, { x: 0px, y: 6px, blur: 0px, color: #24478f, inset: false }, { x: 0px, y: 7px, blur: 0px, color: #1a3a7d, inset: false }, { x: 0px, y: 8px, blur: 0px, color: #122f6b, inset: false }, { x: 0px, y: 16px, blur: 26px, color: rgba(2, 10, 44, 0.6), inset: false }] : self.bf2 ? [{ x: 0px, y: 1px, blur: 0px, color: #9aa3ad, inset: false }, { x: 0px, y: 2px, blur: 0px, color: #86909b, inset: false }, { x: 0px, y: 3px, blur: 0px, color: #737d89, inset: false }, { x: 0px, y: 4px, blur: 0px, color: #616b77, inset: false }, { x: 0px, y: 5px, blur: 0px, color: #505965, inset: false }, { x: 0px, y: 6px, blur: 0px, color: #404853, inset: false }, { x: 0px, y: 7px, blur: 0px, color: #313842, inset: false }, { x: 0px, y: 8px, blur: 0px, color: #232931, inset: false }, { x: 0px, y: 16px, blur: 26px, color: rgba(0, 0, 0, 0.6), inset: false }] : [{ x: 0px, y: 1px, blur: 0px, color: #8a929e, inset: false }, { x: 0px, y: 2px, blur: 0px, color: #77808c, inset: false }, { x: 0px, y: 3px, blur: 0px, color: #646d7a, inset: false }, { x: 0px, y: 4px, blur: 0px, color: #535b67, inset: false }, { x: 0px, y: 5px, blur: 0px, color: #434a55, inset: false }, { x: 0px, y: 6px, blur: 0px, color: #353b45, inset: false }, { x: 0px, y: 7px, blur: 0px, color: #292e36, inset: false }, { x: 0px, y: 8px, blur: 0px, color: #1e222a, inset: false }, { x: 0px, y: 16px, blur: 26px, color: rgba(0, 0, 0, 0.6), inset: false }];
    out property <brush> bfe-logo-fill: self.bf1 ? @linear-gradient(180deg, #ffffff 0%, #e2f0ff 38%, #9fc6f5 70%, #6f9ee3 100%) : self.bf2 ? @linear-gradient(180deg, #ffffff 0%, #e4e8ec 30%, #a9b1ba 52%, #d9dee3 74%, #ffffff 100%) : @linear-gradient(180deg, #ffffff 0%, #f1f4f8 40%, #b9c2cf 72%, #8e98a7 100%);
    out property <color> bfe-tag-ink: self.bf1 ? #13204a : self.bf2 ? #ffffff : #1a1004;
    out property <brush> bfe-tag-fill: self.bf1 ? @linear-gradient(180deg, #ffd27a 0%, #ffa42a 42%, #f57500 100%) : self.bf2 ? @linear-gradient(180deg, #f0554a 0%, #d2281c 50%, #94150c 100%) : @linear-gradient(180deg, #ffd27a 0%, #ffa42a 42%, #f57500 100%);
    out property <length> bfe-gap: self.bf1 ? min(12px, max(7px, self.vh * 1)) : self.bf2 ? min(15px, max(8px, self.vh * 1.3)) : min(14px, max(8px, self.vh * 1.2));
    out property <color> bfe-text: self.bf1 ? #dcefff : self.bf2 ? #ffffff : #e8ecf2;
    out property <color> bfe-text-dim: self.bf1 ? rgba(205, 228, 255, 0.72) : self.bf2 ? rgba(225, 232, 242, 0.76) : rgba(232, 236, 242, 0.66);
    out property <color> bfe-text-faint: self.bf1 ? rgba(205, 228, 255, 0.44) : self.bf2 ? rgba(225, 232, 242, 0.46) : rgba(232, 236, 242, 0.4);
    out property <color> bfe-accent: self.bf1 ? #ffa42a : self.bf2 ? #e0362a : #ff9a1f;
    out property <color> bfe-accent-ink: self.bf1 ? #13204a : self.bf2 ? #ffffff : #170d02;
    out property <brush> bfe-accent-fill: self.bf1 ? @linear-gradient(180deg, #ffd27a 0%, #ffa42a 45%, #f57500 100%) : self.bf2 ? @linear-gradient(180deg, #f0675a 0%, #cf2a1d 48%, #a5180e 52%, #d8483a 100%) : @linear-gradient(90deg, #ffbe55 0%, #ff9419 60%, #f57500 100%);
    out property <color> bfe-value-focus: self.bf1 ? #ffe04a : self.bf2 ? #ffd75a : #ffb347;
    out property <color> bfe-note: self.bf1 ? #dfdf20 : self.bf2 ? #ffd75a : #ffb347;
    out property <brush> bfe-panel-bg: self.bf1 ? @linear-gradient(180deg, rgba(20, 60, 140, 0.55), rgba(6, 22, 60, 0.8)) : self.bf2 ? @linear-gradient(180deg, rgba(22, 46, 86, 0.84), rgba(10, 24, 48, 0.92)) : @linear-gradient(180deg, rgba(14, 17, 24, 0.88), rgba(8, 10, 15, 0.92));
    out property <SurfaceBorder> bfe-panel-border: self.bf1 ? { width: 1px, color: rgba(140, 200, 255, 0.5) } : self.bf2 ? { width: 2px, color: rgba(190, 205, 225, 0.45) } : { width: 1px, color: rgba(255, 255, 255, 0.12) };
    out property <length> bfe-panel-radius: self.bf1 ? 4px : self.bf2 ? 14px : 0px;
    out property <length> bfe-panel-clip: self.bf1 ? 0px : self.bf2 ? 0px : 18px;
    out property <[SurfaceShadow]> bfe-panel-shadow: self.bf1 ? [{ x: 0px, y: 0px, blur: 40px, color: rgba(60, 140, 255, 0.18), inset: true }, { x: 0px, y: 20px, blur: 60px, color: rgba(0, 0, 0, 0.5), inset: false }] : self.bf2 ? [{ x: 0px, y: 1px, blur: 0px, color: rgba(255, 255, 255, 0.15), inset: true }, { x: 0px, y: 20px, blur: 60px, color: rgba(0, 0, 0, 0.55), inset: false }] : [{ x: 0px, y: 24px, blur: 70px, color: rgba(0, 0, 0, 0.55), inset: false }];
    out property <color> bfe-row-line: self.bf1 ? rgba(140, 200, 255, 0.12) : self.bf2 ? rgba(190, 215, 255, 0.1) : rgba(255, 255, 255, 0.06);
    out property <brush> bfe-row-focus: self.bf1 ? @linear-gradient(90deg, rgba(90, 170, 255, 0.32), rgba(90, 170, 255, 0.06)) : self.bf2 ? @linear-gradient(90deg, rgba(224, 54, 42, 0.38), rgba(224, 54, 42, 0.05)) : @linear-gradient(90deg, rgba(255, 154, 31, 0.2), rgba(255, 154, 31, 0.03));
    out property <brush> bfe-track: self.bf1 ? rgba(140, 200, 255, 0.22) : self.bf2 ? @linear-gradient(180deg, #4b535c, #858d96) : rgba(255, 255, 255, 0.14);
    out property <length> bfe-track-radius: self.bf1 ? 4px : self.bf2 ? 6px : 0px;
    out property <brush> bfe-thumb: self.bf1 ? #dff0ff : self.bf2 ? @linear-gradient(180deg, #ffffff, #b9c0c8) : #ffffff;
    out property <SurfaceBorder> bfe-thumb-border: self.bf1 ? { width: 1px, color: #7fb6ff } : self.bf2 ? { width: 1px, color: #23272d } : { width: 0px, color: transparent };
    out property <length> bfe-thumb-radius: self.bf1 ? 3px : self.bf2 ? 9px : 1px;
    out property <color> bfe-list-bg: self.bf1 ? rgba(6, 22, 60, 0.55) : self.bf2 ? rgba(8, 20, 42, 0.6) : rgba(8, 10, 15, 0.6);
    out property <color> bfe-list-hover: self.bf1 ? rgba(120, 190, 255, 0.14) : self.bf2 ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.06);
    out property <color> bfe-list-selected: self.bf1 ? rgba(120, 190, 255, 0.3) : self.bf2 ? rgba(255, 255, 255, 0.18) : rgba(255, 154, 31, 0.2);
    out property <color> bfe-tab-line: self.bf1 ? rgba(140, 200, 255, 0.45) : self.bf2 ? #b31d12 : rgba(255, 255, 255, 0.12);
    out property <brush> bfe-tab-bg: self.bf1 ? rgba(20, 60, 140, 0.45) : self.bf2 ? @linear-gradient(180deg, #3b4148, #1f2328) : transparent;
    out property <brush> bfe-tab-active-bg: self.bf1 ? @linear-gradient(180deg, #ffd27a 0%, #ffa42a 45%, #f57500 100%) : self.bf2 ? @linear-gradient(180deg, #e24a3d, #a5180e) : @linear-gradient(90deg, #ffbe55 0%, #ff9419 60%, #f57500 100%);
    out property <color> bfe-tab-active-ink: self.bf1 ? #13204a : self.bf2 ? #ffffff : #170d02;
    out property <SurfaceBorder> bfe-preview-border: self.bf1 ? { width: 1px, color: rgba(140, 200, 255, 0.6) } : self.bf2 ? { width: 2px, color: #9aa3ad } : { width: 1px, color: rgba(255, 255, 255, 0.18) };
    out property <color> bfe-dialog-bg: self.bf1 ? #0a1a3a : self.bf2 ? #10223f : #0c0f15;
    out property <brush> bfe-dialog-button-bg: self.bf1 ? rgba(60, 130, 240, 0.3) : self.bf2 ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.06);
    out property <color> bfe-dialog-button-border: self.bf1 ? rgba(140, 200, 255, 0.55) : self.bf2 ? rgba(190, 205, 225, 0.5) : rgba(255, 255, 255, 0.22);
    out property <length> bfe-dialog-button-radius: self.bf1 ? 3px : self.bf2 ? 999px : 0px;
    out property <color> bfe-scroll: self.bf1 ? rgba(140, 200, 255, 0.5) : self.bf2 ? rgba(205, 214, 226, 0.55) : rgba(255, 154, 31, 0.45);
    out property <color> bfe-overlay: self.bf1 ? rgba(4, 16, 46, 0.5) : self.bf2 ? rgba(8, 20, 42, 0.5) : rgba(3, 4, 7, 0.52);

    // Responsive layout from style.js. Lengths are logical pixels, so the
    // same viewport contract covers both compositor scale factors.
    out property <length> bfe-gutter: min(56px, max(20px, 3 * self.vw));
    out property <length> bfe-page-frame: min(self.viewport-width - 2 * self.bfe-gutter, 1680px);
    out property <length> bfe-edge: (self.viewport-width - self.bfe-page-frame) / 2;
    out property <length> bfe-frame: self.bfe-page-frame;
    out property <length> options-frame: min(self.bfe-page-frame, 1000px);
    out property <string> font-family: "Saira Thin";
    out property <bool> uppercase: !self.bf2;
    out property <length> button-height: min(56px, max(38px, 5.6 * self.vh));
    out property <length> button-small-height: min(46px, max(34px, 4.6 * self.vh));
    out property <length> button-font-size: self.bf2 ? min(23px, max(15px, 2.2 * self.vh)) : 16px;
    out property <length> button-small-font-size: self.bf2 ? min(19px, max(14px, 1.9 * self.vh)) : min(18px, max(13px, 1.7 * self.vh));
    out property <int> button-weight: self.bf2 ? 800 : 700;
    out property <float> button-tracking: self.bf2 ? 0.02 : self.bf1 ? 0.16 : 0.24;
    out property <float> button-small-tracking: self.eternal ? 0.2 : self.button-tracking;
    out property <length> button-chamfer: self.eternal ? 14px : 0px;
    out property <length> button-small-chamfer: self.eternal ? 10px : 0px;
    out property <length> button-radius: self.bf2 ? 999px : self.bf1 ? 3px : 0px;
    out property <brush> button-bg: self.bf1 ? @linear-gradient(180deg, rgba(60,130,240,0.34), rgba(14,52,140,0.6)) : self.bf2 ? @linear-gradient(180deg, #f4f6f8 0%, #cfd4d9 16%, #a3aab2 48%, #858c95 52%, #b3b9c0 100%) : @linear-gradient(90deg, rgba(20,24,32,0.88), rgba(20,24,32,0.6));
    out property <SurfaceBorder> button-border: self.bf1 ? {width:1px,color:rgba(140,200,255,0.55)} : self.bf2 ? {width:2px,color:#23272d} : {width:1px,color:rgba(255,255,255,0.13)};
    out property <color> button-active-border: self.bf1 ? #ffe2a4 : self.bf2 ? #7a0d06 : #ffc46b;
    out property <brush> button-active-bg: self.bf2 ? @linear-gradient(180deg, #ffd0c8 0%, #f0675a 16%, #cf2a1d 48%, #a5180e 52%, #d8483a 100%) : self.bfe-accent-fill;
    out property <length> title-font-size: min(50px, max(26px, 4.6 * self.vh));
    out property <length> option-height: min(50px, max(36px, 4.8 * self.vh));
    out property <length> option-font-size: min(18px, max(13px, 1.75 * self.vh));
    out property <length> list-row-height: min(42px, max(30px, 4 * self.vh));
    out property <length> list-font-size: min(17px, max(12px, 1.65 * self.vh));
    out property <length> field-height: min(38px, max(30px, 3.8 * self.vh));
    out property <length> field-font-size: min(14px, max(11px, 1.45 * self.vh));
    out property <length> tab-font-size: 16px;
    out property <length> note-font-size: min(15px, max(11px, 1.5 * self.vh));
    out property <length> heading-font-size: min(19px, max(13px, 1.9 * self.vh));
    out property <length> label-font-size: min(17px, max(12px, 1.7 * self.vh));
    out property <length> popup-font-size: min(21px, max(15px, 2.1 * self.vh));
    out property <length> prompt-font-size: min(21px, max(14px, 2.1 * self.vh));
    out property <float> title-stretch: 1.18;
    out property <float> wordmark-stretch: 1.25;
    out property <float> tag-stretch: 1.12;
    out property <length> panel-blur: 10px;
    out property <length> popup-blur: 4px;
    out property <length> overlay-blur: 6px;
    out property <length> title-blur: 3px;
    out property <float> disabled-opacity: 0.4;
    out property <float> option-disabled-opacity: 0.42;
    out property <float> tab-disabled-opacity: 0.5;
    out property <length> button-padding: 1.4 * self.button-font-size;
    out property <length> option-padding: 1.2 * self.vw;
    out property <length> row-gap: 2 * self.vw;
    out property <length> body-gap: 1.6 * self.vh;
    out property <length> head-gap: 3.6 * self.vh;
    out property <length> footer-gap: self.vw;
    out property <length> footer-bottom: 3 * self.vh;
    out property <length> popup-gap: 3.2 * self.vh;
    out property <length> slider-height: 8px;
    out property <length> slider-thumb-width: 14px;
    out property <length> slider-thumb-height: 22px;
    out property <length> focus-ring: 2px;
    out property <duration> hover-duration: 140ms;
    out property <duration> row-duration: 120ms;
    out property <duration> tab-duration: 180ms;
    out property <duration> popup-duration: 260ms;
    out property <duration> popup-out-duration: 220ms;
    out property <duration> screen-in-duration: 500ms;
    out property <duration> screen-out-duration: 220ms;
    out property <duration> item-in-duration: 420ms;
    out property <duration> item-out-duration: 240ms;
    out property <duration> chosen-duration: 360ms;
    out property <duration> row-in-duration: 340ms;
    out property <duration> item-in-stagger: 38ms;
    out property <duration> item-out-stagger: 18ms;
    out property <duration> row-in-stagger: 22ms;
    out property <duration> sheen-duration: 750ms;
    out property <duration> pulse-duration: 1400ms;
    out property <duration> backdrop-duration: 2600ms;
    out property <duration> backdrop-transform-duration: 1600ms;
    out property <duration> movie-crossfade-duration: 1200ms;
    out property <duration> dim-duration: 450ms;
}
