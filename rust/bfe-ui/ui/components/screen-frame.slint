import { Theme, MenuSound } from "../theme.slint";
import { PageTitle, PageBrand } from "typography.slint";
import { PageButton, ButtonVariant } from "button.slint";

export enum ScreenLayout { regular, options, rows, home, wide }
// Head, body and foot share the same frame edges. A screen binds its model
// and places content in the body; it never recalculates the look's gutters.
export component ScreenFrame inherits Rectangle {
    in property <string> title;
    in property <ScreenLayout> layout: ScreenLayout.regular;
    in property <string> left-label: "BACK";
    in property <string> middle-label;
    in property <string> right-label;
    in property <bool> brand-visible: true;
    callback left-activated();
    callback middle-activated();
    callback right-activated();
    property <length> frame-width: root.layout == ScreenLayout.options ? Theme.options-frame : Theme.bfe-page-frame;
    PageBrand { x: Theme.bfe-edge; y: 2.6 * Theme.vh; visible: root.brand-visible; }
    heading := PageTitle {
        x: (root.width - self.width) / 2;
        y: 7 * Theme.vh;
        title: root.title;
    }
    body := Rectangle {
        x: (root.width - root.frame-width) / 2;
        y: heading.y + heading.height + Theme.head-gap;
        width: root.frame-width;
        height: root.height - self.y - 6 * Theme.vh - max(34px, min(46px, 4.6 * Theme.vh));
        @children
    }
    if root.left-label != "": PageButton {
        x: (root.width - root.frame-width) / 2;
        y: root.height - Theme.footer-bottom - self.height;
        label: root.left-label; variant: ButtonVariant.small;
        accept-sound: MenuSound.back; activated => { root.left-activated(); }
    }
    if root.middle-label != "": PageButton {
        x: (root.width - self.width) / 2;
        y: root.height - Theme.footer-bottom - self.height;
        label: root.middle-label; variant: ButtonVariant.small;
        activated => { root.middle-activated(); }
    }
    if root.right-label != "": PageButton {
        x: (root.width + root.frame-width) / 2 - self.width;
        y: root.height - Theme.footer-bottom - self.height;
        label: root.right-label; variant: ButtonVariant.small;
        activated => { root.right-activated(); }
    }
}
