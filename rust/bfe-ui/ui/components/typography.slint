import { Theme } from "../theme.slint";
import { Surface, ChamferStyle } from "surface.slint";

export enum TextRole { heading, label, note, popup, prompt, corner }
export component PageText inherits Text {
    in property <TextRole> role: TextRole.label;
    font-family: Theme.font-family;
    font-size: root.role == TextRole.heading ? Theme.heading-font-size
        : root.role == TextRole.note ? Theme.note-font-size
        : root.role == TextRole.popup ? Theme.popup-font-size
        : root.role == TextRole.prompt ? Theme.prompt-font-size
        : root.role == TextRole.corner ? 12px : Theme.label-font-size;
    font-weight: root.role == TextRole.heading ? 800 : root.role == TextRole.corner ? 600 : 700;
    letter-spacing: self.font-size * (root.role == TextRole.heading ? 0.22 : root.role == TextRole.note ? 0.12
        : root.role == TextRole.popup ? 0.06 : root.role == TextRole.prompt ? 0.32 : root.role == TextRole.corner ? 0.08 : 0.2);
    color: root.role == TextRole.heading ? Theme.bfe-accent : root.role == TextRole.note ? Theme.bfe-note
        : root.role == TextRole.corner ? Theme.bfe-text-faint : root.role == TextRole.label ? Theme.bfe-text-dim : Theme.bfe-text;
    vertical-alignment: center;
    wrap: root.role == TextRole.popup ? word-wrap : no-wrap;
    horizontal-alignment: root.role == TextRole.note || root.role == TextRole.popup || root.role == TextRole.prompt ? center : left;
}

// Titles have one shape policy per look. Their actual strings stay with the
// screen models; no component replaces or abbreviates a menu caption.
export component PageTitle inherits Rectangle {
    in property <string> title;
    property <length> size: Theme.title-font-size * (Theme.bf1 ? 0.78 : Theme.bf2 ? 0.74 : 1);
    preferred-width: title-text.preferred-width + (Theme.bf1 ? 2.6 : Theme.bf2 ? 2.4 : 0) * root.size;
    width: self.preferred-width;
    preferred-height: root.size * (Theme.bf1 ? 1.4 : Theme.bf2 ? 1.5 : 1.3);
    height: self.preferred-height;
    Surface {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        visible: !Theme.eternal;
        bottom-cut: false;
        fill: Theme.bf1 ? Theme.bfe-tag-fill : Theme.bfe-tab-active-bg;
        edge: {width:Theme.bf2 ? 2px : 0px,color:#2b0703};
        radius: Theme.bf2 ? root.size * 0.45 : 0px;
        chamfer: Theme.bf1 ? root.size : 0px;
        chamfer-style: ChamferStyle.top-right;
    }
    title-text := Text {
        x: (parent.width - self.preferred-width) / 2;
        // The browser's eternal title sits on a line box of one em with the underline below it.
        y: Theme.eternal ? -0.2 * root.size : 0px;
        height: parent.height;
        text: root.title.to-uppercase();
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: 850;
        letter-spacing: 0.06 * self.font-size;
        color: Theme.bf1 ? #13204a : white;
        horizontal-alignment: center;
        vertical-alignment: center;
        stroke: Theme.bf2 ? #111 : transparent;
        stroke-width: Theme.bf2 ? 1px : 0px;
        stroke-style: outside;
    }
    if Theme.eternal: Rectangle {
        x: 0px;
        y: root.height - 3px;
        width: root.width;
        height: 3px;
        background: @linear-gradient(90deg, transparent, #ff9a1f 25%, #ff9a1f 75%, transparent);
    }
}

// The bundled 900 face supplies the expanded wordmark. Depth layers retain
// the browser's ordered colour steps; the amber/red tag is a separate shape.
export component Wordmark inherits Rectangle {
    in property <length> size: min(104px, min(5.5 * Theme.vw, 10 * Theme.vh));
    preferred-width: word.preferred-width;
    width: self.preferred-width;
    preferred-height: root.size * 1.35;
    height: self.preferred-height;
    property <float> depth-scale: root.size / 72px;
    for shadow in Theme.bfe-logo-depth: Text {
        x: shadow.x * root.depth-scale;
        y: -0.37 * root.size + shadow.y * root.depth-scale;
        height: 1.2 * root.size;
        text: "BATTLEFRONT";
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: 900;
        letter-spacing: -0.01 * root.size;
        color: shadow.color;
        visible: shadow.blur == 0px;
    }
    word := Text {
        x: 0px;
        y: -0.37 * root.size;
        height: 1.2 * root.size;
        text: "BATTLEFRONT";
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: 900;
        letter-spacing: -0.01 * root.size;
        color: Theme.bfe-logo-text-fill;
    }
    tag := Surface {
        x: root.width - self.width - root.size * 0.1;
        y: root.size * 0.94;
        width: tag-text.preferred-width + root.size * 0.25 * 3.3;
        height: root.size * 0.25 * 1.56;
        fill: Theme.bfe-tag-fill;
        edge: {width:0px,color:transparent};
        radius: 0px;
        chamfer: root.size * 0.25 * 1.5;
        chamfer-style: ChamferStyle.top-right;
        tag-text := Text {
            x: root.size * 0.25 * 0.9;
            y: 0px;
            height: parent.height;
            text: "ETERNAL";
            font-family: Theme.font-family;
            font-size: root.size * 0.25;
            font-weight: 800;
            letter-spacing: root.size * 0.25 * 0.5;
            color: Theme.bfe-tag-ink;
            vertical-alignment: center;
        }
    }
}

export component PageBrand inherits Wordmark {
    size: min(32px, min(1.7 * Theme.vw, 3.2 * Theme.vh));
}

// Top-left planet name on the loading screen in eternal and bf2 looks
// (src/shell/loading.js LOOKS.eternal.type / LOOKS.bf2.type).
export component LoadingPlanetText inherits Rectangle {
    in property <string> label;
    in property <length> unit: 1px;
    property <length> size: (Theme.bf2 ? 16 : 15) * root.unit;
    property <length> track: self.size * (Theme.bf2 ? 0.04 : 0.24);
    width: glyph.preferred-width;
    height: glyph.preferred-height;
    shadow := Text {
        x: 0px;
        y: root.unit;
        text: root.label;
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: Theme.bf2 ? 800 : 700;
        letter-spacing: root.track;
        color: Theme.bf2 ? rgba(0, 0, 0, 0.6) : rgba(0, 0, 0, 0.85);
        vertical-alignment: center;
    }
    glyph := Text {
        x: 0px;
        y: 0px;
        text: root.label;
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: Theme.bf2 ? 800 : 700;
        letter-spacing: root.track;
        color: Theme.bf2 ? #ffffff : #e8ecf2;
        stroke: Theme.bf2 ? #111111 : transparent;
        stroke-width: Theme.bf2 ? 2 * root.unit : 0px;
        stroke-style: outside;
        vertical-alignment: center;
    }
}

// Tilted -14deg LOADING text centered on the lower-right loading disk
// in eternal and bf2 looks (src/shell/loading.js drawDisk / write).
export component LoadingWordText inherits Rectangle {
    in property <string> label: "LOADING";
    in property <length> unit: 1px;
    in property <angle> tilt: -14deg;
    property <length> size: (Theme.bf2 ? 15 : 13) * root.unit;
    property <length> track: self.size * (Theme.bf2 ? 0.04 : 0.24);
    // The disk is turned about its vertical axis (loading.js DISK.turn), which squeezes the word with it.
    property <float> turn: 0.866;
    width: word.preferred-width;
    height: word.preferred-height;
    shadow := Text {
        x: 0px;
        y: root.unit;
        text: root.label;
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: Theme.bf2 ? 700 : 500;
        letter-spacing: root.track;
        color: Theme.bf2 ? rgba(0, 0, 0, 0.6) : rgba(0, 0, 0, 0.85);
        transform-scale-x: root.turn;
        transform-rotation: root.tilt;
    }
    word := Text {
        x: 0px;
        y: 0px;
        text: root.label;
        font-family: Theme.font-family;
        font-size: root.size;
        font-weight: Theme.bf2 ? 700 : 500;
        letter-spacing: root.track;
        color: Theme.bf2 ? #ffffff : #e8ecf2;
        stroke: Theme.bf2 ? #111111 : transparent;
        stroke-width: Theme.bf2 ? 2 * root.unit : 0px;
        stroke-style: outside;
        transform-scale-x: root.turn;
        transform-rotation: root.tilt;
    }
}
