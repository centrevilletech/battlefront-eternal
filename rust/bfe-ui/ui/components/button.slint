import { Theme, ControlState, MenuSound } from "../theme.slint";
import { Interaction } from "interaction.slint";
import { Surface } from "surface.slint";

export enum ButtonVariant { menu, small, dialog, accept, ghost }
// looks.css button variants share one interaction owner. Pressed keeps the
// browser's active fill; it does not introduce an extra native shrink state.
export component PageButton inherits Interaction {
    in property <string> label;
    in property <ButtonVariant> variant: ButtonVariant.menu;
    in property <bool> highlighted: false;
    // Dialog buttons: 13.333px in the page's own dialogs, 16px in the offer and notice dialogs.
    in property <length> dialog-font-size: Theme.dialog-button-font-size;
    // The ring around a highlighted dialog button (the look's value focus unless a dialog says otherwise).
    in property <color> focus-ring-color: Theme.bfe-value-focus;
    property <bool> small: root.variant == ButtonVariant.small;
    property <bool> dialog: root.variant == ButtonVariant.dialog || root.variant == ButtonVariant.accept;
    property <bool> lit: (!root.dialog && (root.active || root.highlighted)) || root.variant == ButtonVariant.accept;
    property <length> size: root.dialog ? root.dialog-font-size : root.small ? Theme.button-small-font-size : Theme.button-font-size;
    property <length> pad-x: root.dialog ? Theme.dialog-button-pad-x : 1.4 * root.size;
    preferred-height: root.dialog ? 43px : root.small ? Theme.button-small-height : Theme.button-height;
    height: self.preferred-height;
    in property <length> min-btn-width: root.small ? Theme.button-small-min-width : 0px;
    preferred-width: max(root.min-btn-width, label-text.preferred-width + 2 * root.pad-x);
    width: self.preferred-width;
    opacity: root.visual-state == ControlState.disabled ? Theme.disabled-opacity : 1;
    accessible-role: button;
    accessible-label: root.label;
    if root.dialog && (root.highlighted || root.focus-visible || root.visual-state == ControlState.focused): Rectangle {
        x: -6px; y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        background: transparent;
        border-width: 3px;
        border-color: root.focus-ring-color;
        border-radius: Theme.bfe-dialog-button-radius + 3px;
    }
    skin := Surface {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        fill: root.variant == ButtonVariant.ghost ? transparent : root.dialog ? (root.variant == ButtonVariant.accept ? Theme.bfe-accent-fill : Theme.bfe-dialog-button-bg) : root.lit ? Theme.button-active-bg : Theme.button-bg;
        edge: { width: root.variant == ButtonVariant.ghost ? 0px : root.dialog ? 1px : Theme.button-border.width,
            color: root.variant == ButtonVariant.accept ? transparent : (root.lit || (root.dialog && root.active)) ? Theme.button-active-border : root.dialog ? Theme.bfe-dialog-button-border : Theme.button-border.color };
        radius: root.dialog ? Theme.bfe-dialog-button-radius : Theme.button-radius;
        chamfer: root.dialog ? 0px : root.small ? Theme.button-small-chamfer : Theme.button-chamfer;
        animate fill { duration: Theme.hover-duration; }
        // BF2 enlarges the selected chrome by three percent.
        transform-scale-x: root.lit && Theme.bf2 && !root.dialog ? 103% : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: Theme.hover-duration; }
        if Theme.eternal && !root.dialog && !root.lit: Rectangle {
            x: 0px; y: Theme.button-chamfer;
            width: 3px; height: parent.height - Theme.button-chamfer;
            background: Theme.bfe-accent; opacity: 0.55;
        }
        label-text := Text {
            x: (parent.width - self.preferred-width) / 2;
            y: 0px;
            height: parent.height;
            text: Theme.format-label(root.label, root.dialog || !Theme.bf2);
            font-family: Theme.font-family;
            font-size: root.size;
            font-weight: root.dialog ? 700 : Theme.button-weight;
            letter-spacing: root.size * (root.dialog ? 0.1 : root.small ? Theme.button-small-tracking : Theme.button-tracking);
            color: root.lit ? Theme.bfe-accent-ink : Theme.bfe-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            stroke: Theme.bf2 && !root.dialog ? #111 : transparent;
            stroke-width: Theme.bf2 && !root.dialog ? 1px : 0px;
            stroke-style: outside;
        }
    }
}
