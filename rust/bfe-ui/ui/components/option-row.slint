import { Theme, ControlState, MenuSound } from "../theme.slint";
import { Interaction } from "interaction.slint";
import { PageSlider } from "slider.slint";

export enum OptionKind { choice, slider, fixed, action, binding, toggle }
export component OptionArrow inherits Interaction {
    in property <bool> previous: false;
    in property <bool> row-active: false;
    accept-sound: MenuSound.select;
    preferred-width: 14px;
    // No fixed height: the row's layout stretches the arrow so the glyph centres on the value.
    preferred-height: 21px;
    Text {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.previous ? "\u{2039}" : "\u{203a}";
        font-family: Theme.font-family;
        font-size: Theme.option-font-size;
        font-weight: 700;
        color: root.active ? Theme.bfe-text : root.row-active ? Theme.bfe-accent : Theme.bfe-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
// OptionRow's model still chooses values and accepts changes. This shared
// skin owns label/value layout, the focus rail and all pointer affordances.
export component OptionRow inherits Interaction {
    in property <string> label;
    in property <string> value-text;
    in property <OptionKind> kind: OptionKind.choice;
    in property <bool> dim-value: false;
    in-out property <float> fraction: 0.5;
    callback value-changed(float);
    callback action();
    property <bool> bare: root.label == "";
    accept-sound: root.kind == OptionKind.choice || root.kind == OptionKind.toggle ? MenuSound.select : MenuSound.accept;
    preferred-height: Theme.option-height;
    height: self.preferred-height;
    preferred-width: 600px;
    interactive: root.kind != OptionKind.fixed;
    cursor: root.kind == OptionKind.fixed ? default : pointer;
    opacity: root.visual-state == ControlState.disabled ? Theme.option-disabled-opacity : 1;
    activated => { if (root.kind != OptionKind.fixed) { root.action(); } }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: root.active ? Theme.bfe-row-focus : transparent;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.bfe-row-line; }
        if root.active: Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: Theme.bfe-accent; }
    }
    if !root.bare: Text {
        x: Theme.option-padding;
        y: 0px;
        width: (root.width - 2 * Theme.option-padding - Theme.row-gap) / 2.1;
        height: root.height;
        text: root.label.to-uppercase();
        font-family: Theme.font-family;
        font-size: Theme.option-font-size;
        font-weight: 700;
        letter-spacing: 0.12 * self.font-size;
        color: root.active ? Theme.bfe-text : Theme.bfe-text-dim;
        vertical-alignment: center;
        overflow: elide;
    }
    values := HorizontalLayout {
        x: root.bare ? Theme.option-padding : (root.width - 2 * Theme.option-padding - Theme.row-gap) / 2.1 + Theme.option-padding + Theme.row-gap;
        y: 0px;
        width: root.bare ? root.width - 2 * Theme.option-padding : root.width - self.x - Theme.option-padding;
        height: root.height;
        spacing: 0.7 * Theme.option-font-size;
        alignment: root.bare ? center : end;
        if root.kind == OptionKind.slider: PageSlider {
            // The browser's slider grows to 300px and shrinks to 110px.
            preferred-width: 300px;
            max-width: 300px;
            horizontal-stretch: 1;
            value <=> root.fraction;
            disabled: root.disabled;
            focus-on-hover: root.focus-on-hover;
            selected => { root.selected(); }
            value-changed(value) => { root.value-changed(value); }
        }
        if root.kind == OptionKind.choice || root.kind == OptionKind.toggle: OptionArrow {
            previous: true; disabled: root.disabled; row-active: root.active;
            focus-on-hover: root.focus-on-hover;
            selected => { root.selected(); }
            activated => { root.stepped(-1); }
        }
        if root.kind != OptionKind.action: Text {
            min-width: (root.kind == OptionKind.slider || root.kind == OptionKind.fixed ? 4.5 : 9) * Theme.option-font-size;
            text: root.value-text.to-uppercase();
            font-family: Theme.font-family;
            font-size: Theme.option-font-size;
            font-weight: 700;
            letter-spacing: 0.08 * self.font-size;
            color: root.active ? Theme.bfe-value-focus : Theme.bfe-text;
            opacity: root.dim-value ? 0.5 : 1;
            horizontal-alignment: root.kind == OptionKind.slider || root.kind == OptionKind.fixed ? right : center;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.kind == OptionKind.action: Rectangle {
            width: action-label.preferred-width + 2.6 * Theme.option-font-size;
            height: 1.9 * Theme.option-font-size;
            y: (parent.height - self.height) / 2;
            background: root.active ? Theme.bfe-accent-fill : transparent;
            border-width: root.active ? 0px : 1px;
            border-color: Theme.bfe-accent;
            action-label := Text {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: root.value-text.to-uppercase();
                font-family: Theme.font-family;
                font-size: Theme.option-font-size;
                font-weight: 700;
                letter-spacing: 0.14 * self.font-size;
                color: root.active ? Theme.bfe-accent-ink : Theme.bfe-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.kind == OptionKind.choice || root.kind == OptionKind.toggle: OptionArrow {
            disabled: root.disabled; row-active: root.active;
            focus-on-hover: root.focus-on-hover;
            selected => { root.selected(); }
            activated => { root.stepped(1); }
        }
    }
}

// Pill toggle switch from server-browser-view.js (.bfe-toggle).
export component PageToggle inherits Interaction {
    in property <string> label;
    in-out property <bool> checked: false;
    callback toggled(bool);
    property <length> size: min(13px, max(11px, 1.4 * Theme.vh));
    preferred-height: 28px;
    height: self.preferred-height;
    preferred-width: 2.9 * root.size + toggle-text.preferred-width;
    opacity: root.visual-state == ControlState.disabled ? Theme.disabled-opacity : 1;
    activated => { root.checked = !root.checked; root.toggled(root.checked); }
    stepped(delta) => { root.checked = !root.checked; root.toggled(root.checked); Theme.sound-requested(MenuSound.accept); }
    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        spacing: 0.5 * root.size;
        alignment: start;
        Rectangle {
            width: 2.4 * root.size;
            height: 1.3 * root.size;
            y: (parent.height - self.height) / 2;
            border-radius: 0.65 * root.size;
            background: root.checked ? Theme.bfe-accent : rgba(255, 255, 255, 0.14);
            border-width: root.visual-state == ControlState.focused ? 1px : 0px;
            border-color: Theme.bfe-accent;
            animate background { duration: Theme.tab-duration; }
            Rectangle {
                x: (root.checked ? 1.25 : 0.15) * root.size;
                y: 0.15 * root.size;
                width: root.size;
                height: root.size;
                border-radius: 0.5 * root.size;
                background: Theme.bfe-text;
                animate x { duration: Theme.tab-duration; }
            }
        }
        toggle-text := Text {
            text: root.label.to-uppercase();
            font-family: Theme.font-family;
            font-size: root.size;
            font-weight: 700;
            letter-spacing: 0.12 * self.font-size;
            color: root.active ? Theme.bfe-text : Theme.bfe-text-dim;
            vertical-alignment: center;
        }
    }
}
